{
  "name": "dmxr-server",
  "version": "1.3.3",
  "description": "DMXr bridge server — receives fixture color data via HTTP and outputs DMX",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run --config vitest.config.ui.ts",
    "test:ui:watch": "vitest --config vitest.config.ui.ts",
    "test:ui:update": "UPDATE_BASELINES=1 vitest run --config vitest.config.ui.ts",
    "test:contract": "vitest run --config vitest.config.contract.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "check:node-pin": "tsx scripts/check-node-pin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.3.0",
    "dmx-ts": "0.4.0",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.8.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.10.0",
    "semver": "^7.8.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
