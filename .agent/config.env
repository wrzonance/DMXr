# .agent/config.env -- repository facts for agent skills.
# Generated by bootstrap-repo.sh. Parsed line-wise, never sourced.
# Regenerate with: bootstrap-repo.sh --force

AGENT_REPO_SLUG=wrzonance/DMXr
AGENT_BASE_BRANCH=main
AGENT_PROJECT_OWNER=wrzonance
AGENT_PROJECT_NUMBER=9
AGENT_STATUS_VOCAB=Backlog,Ready,In progress,In review,Done
AGENT_WORKTREE_ROOT=.worktrees

# This repository's labels, for you to split by intent. Uncomment and
# classify the ones agents should reuse instead of inventing new labels.
#   bug,documentation,duplicate,enhancement,good first issue,help wanted,invalid,question,wontfix,dependencies,github_actions,javascript,ofl,automated,major-update,ci
AGENT_LABEL_TYPES=bug,documentation,duplicate,enhancement,help wanted,invalid,question,wontfix
AGENT_LABEL_AREAS=ci,dependencies,github_actions,javascript,ofl,automated
# AGENT_LABEL_PRIORITIES=

# Candidate verify commands found in this repository. Uncomment the ones
# agents should run, as AGENT_CMD_<NAME>=<command>. Commands are argv:
# no shell, no pipes, no redirects. For anything more, use .agent/runner.
# component: . (shell, *.sh)
# shellcheck needs explicit file operands -- argv cannot glob, so choose
# the paths this repository wants checked:
AGENT_CMD_LINT_SHELL=shellcheck server/scripts/dmxr-server.sh server/scripts/install.sh server/scripts/uninstall.sh

# component: server (node, package.json)
AGENT_CMD_SERVER_BUILD=npm run build
AGENT_RUNDIR_SERVER_BUILD=server
AGENT_CMD_SERVER_TYPECHECK_SCRIPTS=npm run typecheck:scripts
AGENT_RUNDIR_SERVER_TYPECHECK_SCRIPTS=server
AGENT_CMD_SERVER_NODE_PIN=npm run check:node-pin
AGENT_RUNDIR_SERVER_NODE_PIN=server

# Every value above is argv -- no shell, no &&, no pipes -- and none of it has
# been run. Put each command through agent-run.sh before uncommenting it.
AGENT_CMD_SETUP=npm ci
AGENT_RUNDIR_SETUP=server
AGENT_CMD_VERIFY=npm run typecheck
AGENT_RUNDIR_VERIFY=server
AGENT_CMD_TEST=npm run test:coverage
AGENT_RUNDIR_TEST=server
